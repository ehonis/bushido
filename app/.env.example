# Frontend build-time settings. Copy to app/.env; Vite reads it on `npm run build`.
# All optional. Nothing here has a default.

# The hostname this install is published at. A Totem goal whose URL link points
# here is shown on the Today tab, and retired hostnames below move here.
# VITE_BUSHIDO_HOST=bushido.example.com

# Older hostnames that goal links stored elsewhere may still point at (comma-separated).
# VITE_BUSHIDO_LEGACY_HOSTS=old-name.example.com

# Retired hostnames that should hand an open page over to VITE_BUSHIDO_HOST once its
# offline outbox has synced (comma-separated).
# VITE_BUSHIDO_HANDOFF_FROM=old-name.example.com

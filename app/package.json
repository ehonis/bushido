{
  "name": "bushido-app",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehonis/bushido.git",
    "directory": "app"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "esbuild smoke/index.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=smoke/.smoke.mjs --log-level=error && node smoke/.smoke.mjs",
    "test:workout": "node workout.test.js",
    "test:circuit": "node circuit.test.js",
    "test": "node ../scripts/test.mjs app",
    "test:lifts": "node lifts.test.js",
    "test:gear": "node gear.test.js",
    "test:progress": "node progress.test.js",
    "palette": "node validate_palette.js",
    "test:figures": "esbuild figures.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.figurestest.mjs --log-level=error && node .figurestest.mjs",
    "test:md": "esbuild markdown.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.mdtest.mjs --log-level=error && node .mdtest.mjs",
    "test:streak": "node streak.test.js",
    "test:presc": "node prescription.test.js",
    "test:naming": "node naming.test.js",
    "test:starter": "node starter.test.mjs",
    "test:exercises": "node exercises.test.mjs",
    "test:signout": "node signout.test.js",
    "test:whoami": "node whoami.test.js",
    "test:shared": "node shared.test.js",
    "test:trainer": "node trainer.test.js",
    "test:drafts": "node drafts.test.js",
    "test:planflow": "esbuild planflow.test.js --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.planflowtest.mjs --log-level=error && node .planflowtest.mjs",
    "test:editing": "esbuild editing.test.js --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.editingtest.mjs --log-level=error && node .editingtest.mjs && esbuild editing.dom.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.editingdomtest.mjs --log-level=error && node .editingdomtest.mjs",
    "test:blockmenu": "esbuild blockmenu.dom.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.blockmenudomtest.mjs --log-level=error && node .blockmenudomtest.mjs",
    "test:runner": "esbuild runner.dom.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.runnerdomtest.mjs --log-level=error && node .runnerdomtest.mjs",
    "test:runflow": "node runflow.test.js",
    "test:native": "esbuild native.test.js --bundle --platform=node --format=esm --packages=external --outfile=.nativetest.mjs --log-level=error && node .nativetest.mjs",
    "test:merge": "node merge.test.js",
    "test:targets": "esbuild targets.dom.test.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=smoke/.targetsdomtest.mjs --log-level=error && node smoke/.targetsdomtest.mjs",
    "test:done": "node done.test.js",
    "test:history": "node history.test.js",
    "test:fingers": "node fingers.test.js",
    "test:tests": "node tests.test.js",
    "test:handoff": "node handoff.test.js",
    "test:libsync": "node libsync.test.js",
    "test:cycles": "node cycles.test.js",
    "test:sessionops": "node sessionops.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^15.11.7",
    "vite": "^7.1.5"
  }
}

# Bushido server configuration. Every variable is optional. Most of these can
# also be set on the Settings page; an environment variable always wins over
# the page, and the page shows which ones are pinned.
#
# The server does not read this file itself. The systemd unit in deploy/ loads
# ~/bushido/.env through EnvironmentFile= if it exists, and docker-compose.yml
# takes an environment: block. Under plain `npm start`, export them in your shell.
#
# Build-time settings for the frontend live in app/.env (see app/.env.example).

# --- Server -------------------------------------------------------------------
# BUSHIDO_PORT=8099
# BUSHIDO_BIND=0.0.0.0          # bind to a private interface if you can
# The address you open the app at. Only used to print a clickable setup link.
# BUSHIDO_PUBLIC_URL=https://bushido.example.com

# --- Sign-in ------------------------------------------------------------------
# Default: one owner account with a password, created from the setup link the
# server prints on first start. Set to "proxy" ONLY when something in front of
# this port already authenticates every request (Cloudflare Access, an auth
# proxy); then there is no login at all.
# An install upgraded from before sign-in existed gets auth.mode "proxy" in
# data/settings.json; this variable beats it in both directions (proxy / password).
# BUSHIDO_AUTH=proxy
# A bearer token for scripts and other services: Authorization: Bearer <token>.
# At least 16 characters. This is the only bearer token accepted; the Totem
# bridge secret is for Bushido calling Totem and does not sign anyone in.
# BUSHIDO_API_TOKEN=
# Whether to throttle logins by X-Forwarded-For / CF-Connecting-IP instead of the
# socket address. Unset: trusted only from a loopback peer (a tunnel on this
# machine). 1: always trusted (a reverse proxy elsewhere). 0: never.
# BUSHIDO_TRUST_PROXY=

# --- More than one person (proxy mode behind Cloudflare Access) ---------------
# With both set, the token Cloudflare Access signs each request with is verified
# and its email picks the person from data/users.json (Settings → People). Each
# person has their own log; the owner can act as anyone. A request with no Access
# token is the owner, as in plain proxy mode. Unset: one user, the owner.
# The team: its *.cloudflareaccess.com domain, or just the part before it.
# BUSHIDO_ACCESS_TEAM=your-team
# The Access application's "Application Audience (AUD) Tag".
# BUSHIDO_ACCESS_AUD=

# --- Paths (default: relative to the repo root) -------------------------------
# BUSHIDO_DATA_DIR=./data       # the training log, backups, settings, the account
# BUSHIDO_DIST_DIR=./dist       # the built frontend
# The content file. Default: data/plan.json if you imported one in Settings,
# otherwise content/starter.json. examples/plan.json is a small invented example.
# BUSHIDO_PLAN_FILE=
# BUSHIDO_CONTENT_DIR=          # older form: a directory containing plan.json

# --- AI (headless Claude Code CLI) --------------------------------------------
# Found at ~/.local/bin/claude or on PATH when unset. Without it the app runs
# and the coach and planners say "set up AI in Settings".
# CLAUDE_BIN=~/.local/bin/claude
# Passed through to the CLI. Leave unset to use the CLI's own login.
# ANTHROPIC_API_KEY=
# BUSHIDO_COACH_MODEL=claude-sonnet-5
# BUSHIDO_COACH_EFFORT=medium
# BUSHIDO_COACH_TIMEOUT_MS=180000
# BUSHIDO_PLANNER_MODEL=claude-sonnet-5
# BUSHIDO_PLANNER_EFFORT=low
# BUSHIDO_PLANNER_TIMEOUT_MS=150000
# BUSHIDO_WEEK_EFFORT=low
# BUSHIDO_WEEK_TIMEOUT_MS=240000

# --- Optional local services (all off unless set) -----------------------------
# A Markdown athlete profile the AI may read, and append dated memories beside.
# BUSHIDO_BRAIN_FILE=
# A directory holding digest.json from a separate food-log app; read-only.
# BUSHIDO_KRAKATOA_DIR=
# A push-notification core (push.mjs, store.mjs, ...) loaded by path. Off when
# unset, and with it the only timer the server runs.
# BUSHIDO_NOTIFY_CORE=
# Contact for the VAPID identity. Only read when data/vapid.json is first created.
# BUSHIDO_VAPID_SUBJECT=mailto:admin@example.com
# Timezone for scheduled notifications. Default: the server's.
# BUSHIDO_TZ=

# --- Totem bridge: WHOOP, Strava, goals, habit sync (off unless set) ----------
# WHOOP and Strava are read through this bridge, which holds the OAuth grants.
# Bushido stores no WHOOP or Strava credentials of its own.
# BUSHIDO_TOTEM_URL=http://127.0.0.1:8787
# BRIDGE_SECRET=
# Or read BRIDGE_SECRET from the bridge's own .env file:
# BUSHIDO_TOTEM_ENV=
# BUSHIDO_TOTEM_HABIT=move-every-day
# BUSHIDO_WHOOP_DAYS=21
# BUSHIDO_WHOOP_TTL_MS=600000
# BUSHIDO_STRAVA_DAYS=21
# BUSHIDO_STRAVA_TTL_MS=600000
# BUSHIDO_GOALS_TTL_MS=600000

# --- Legacy check-in coach (dormant; no route reaches it) ---------------------
# BUSHIDO_CHAT_MODEL=claude-sonnet-5
# BUSHIDO_CHAT_EFFORT=low
# BUSHIDO_CHAT_TIMEOUT_MS=120000
